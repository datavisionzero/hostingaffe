# Copy to deploy/.env and fill in the four values above the optional block.
# The file is ignored by git.

# The database password, shared by the two services.
POSTGRES_PASSWORD=

# The first administrator, email and token, read on the first start only.
# The token is what the CLI carries as HOSTINGAFFE_TOKEN; at least 32 characters.
HOSTINGAFFE_BOOTSTRAP_ADMIN=
HOSTINGAFFE_BOOTSTRAP_EMAIL=
HOSTINGAFFE_BOOTSTRAP_TOKEN=

# Optional. Defaults shown.
# HOSTINGAFFE_DELETION_GRACE_DAYS=7
# HOSTINGAFFE_LOG_ENDPOINT=https://logs.example.org
# HOSTINGAFFE_LOG_TOKEN=
# HOSTINGAFFE_LOG_LEVEL=Information

# The host port. The value is the whole left half of the published port, so an
# address in front of it binds there and nowhere else. Behind a reverse proxy on
# the same machine that is the second line, not the first.
# HOSTINGAFFE_PORT=8080
# HOSTINGAFFE_PORT=127.0.0.1:8080

# The image this instance runs. `:latest` is the newest stable release and
# never a prerelease; `:main` follows the trunk; a `sha-<commit>` or a version
# pins the installation to one build, which is the way off a release or a trunk
# that turned out bad without waiting for the next one.
# HOSTINGAFFE_IMAGE=ghcr.io/datavisionzero/hostingaffe:latest

# The reverse proxy in front of the instance, so that the caller's address and
# scheme are the caller's rather than the proxy's. An address, a CIDR network,
# or `all` where the proxy is the only thing that can reach the instance.
# HOSTINGAFFE_TRUSTED_PROXY=all

# Transactional email. Leave all of these unset to disable it.
# HOSTINGAFFE_PUBLIC_URL=https://hosts.example.org
# HOSTINGAFFE_SMTP_HOST=smtp.example.org
# HOSTINGAFFE_SMTP_PORT=587
# HOSTINGAFFE_SMTP_USERNAME=
# HOSTINGAFFE_SMTP_PASSWORD=
# HOSTINGAFFE_SMTP_SECURITY=starttls
# HOSTINGAFFE_SMTP_FROM_ADDRESS=no-reply@example.org
# HOSTINGAFFE_SMTP_FROM_NAME=hostingaffe
